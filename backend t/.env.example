PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/appdb
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:3000

# Chat agent (POST /api/v1/chat/completions).
# The Graph Studio query endpoint for the deployed subgraph:
SUBGRAPH_URL=
# Provider: Groq preferred when set, else Anthropic. One key is required.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
